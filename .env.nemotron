# RunPod Configuration for Llama-Nemotron Cross-Architecture Validation
# Date: 2025-12-07
# Reference: docs/Cross_Architecture_Validation_Plan.md

# ============================================================================
# PROJECT CONFIGURATION
# ============================================================================
PROJECT_ROOT=/workspace/agent-green

# ============================================================================
# BACKEND SELECTION
# ============================================================================
USE_RUNPOD=true  # vLLM uses OpenAI-compatible API

# ============================================================================
# MODEL FAMILY IDENTIFIER
# ============================================================================
MODEL_FAMILY=nemotron

# ============================================================================
# REASONING MODE TOGGLE
# ============================================================================
# Nemotron uses system prompt toggle (not API parameter like Qwen3)
# - Nano-8B v1: "detailed thinking on" / "detailed thinking off"
# - Super-49B v1.5: default=thinking ON, "/no_think"=thinking OFF
ENABLE_REASONING=false  # Will be toggled by experiment script

# ============================================================================
# MODEL CONFIGURATION (RunPod - H100 GPU)
# ============================================================================

# --- Llama-3.1-Nemotron-Nano-8B-v1 ---
# Base: Llama-3.1-8B | Architecture: Dense | Context: 128K | Precision: FP16
# Toggle: System prompt "detailed thinking on/off"
REASONING_MODEL=nvidia/Llama-3.1-Nemotron-Nano-8B-v1
REASONING_ENDPOINT=http://localhost:8000/v1
REASONING_API_KEY=

BASELINE_MODEL=nvidia/Llama-3.1-Nemotron-Nano-8B-v1
BASELINE_ENDPOINT=http://localhost:8000/v1
BASELINE_API_KEY=

# ============================================================================
# DATASETS
# ============================================================================
VULN_DATASET=/workspace/agent-green/vuln_database/VulTrial_386_samples_balanced.jsonl
HUMANEVAL_DATASET=/workspace/agent-green/vuln_database/HumanEval.jsonl

# ============================================================================
# EXPERIMENT SETTINGS
# ============================================================================
# Nemotron recommended settings:
# - Thinking ON: temperature=0.6, top_p=0.95
# - Thinking OFF: temperature=0.0 (greedy)
# For cross-architecture comparison, we use temperature=0.0 to match Qwen3 baseline
TEMPERATURE=0.0
LLM_SERVICE=openai

# ============================================================================
# RESULTS DIRECTORY
# ============================================================================
RESULTS_DIR=/workspace/agent-green/results

# ============================================================================
# NEMOTRON CONTEXT LENGTH
# ============================================================================
# Llama-Nemotron models inherit 128K context from Llama 3.1
# Standardized to 64K to match Qwen3 experiments for fair comparison
MAX_CONTEXT_LENGTH=65536
