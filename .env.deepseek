# RunPod Configuration for DeepSeek Cross-Architecture Validation
# Date: 2025-12-06
# Reference: docs/Cross_Architecture_Validation_Plan.md

# ============================================================================
# PROJECT CONFIGURATION
# ============================================================================
PROJECT_ROOT=/workspace/agent-green

# ============================================================================
# BACKEND SELECTION
# ============================================================================
USE_RUNPOD=true  # vLLM uses OpenAI-compatible API

# ============================================================================
# REASONING MODE TOGGLE
# ============================================================================
ENABLE_REASONING=false  # Will be toggled by experiment script

# ============================================================================
# MODEL CONFIGURATION (RunPod - H100 GPU)
# ============================================================================

# --- DeepSeek-R1-Distill-Llama-8B ---
# Base: Llama-3.1-8B | Architecture: Dense | Context: 128K | Precision: FP16
REASONING_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-8B
REASONING_ENDPOINT=http://localhost:8000/v1
REASONING_API_KEY=

BASELINE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-8B
BASELINE_ENDPOINT=http://localhost:8000/v1
BASELINE_API_KEY=

# --- DeepSeek-R1-Distill-Llama-70B (uncomment for 70B experiments) ---
# Base: Llama-3.3-70B | Architecture: Dense | Context: 128K | Precision: INT8
# REASONING_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-70B
# REASONING_ENDPOINT=http://localhost:8000/v1
# REASONING_API_KEY=
#
# BASELINE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-70B
# BASELINE_ENDPOINT=http://localhost:8000/v1
# BASELINE_API_KEY=

# ============================================================================
# DATASETS
# ============================================================================
VULN_DATASET=/workspace/agent-green/vuln_database/VulTrial_386_samples_balanced.jsonl
HUMANEVAL_DATASET=/workspace/agent-green/vuln_database/HumanEval.jsonl

# ============================================================================
# EXPERIMENT SETTINGS (matching Qwen3 baseline)
# ============================================================================
TEMPERATURE=0.0
LLM_SERVICE=openai

# ============================================================================
# RESULTS DIRECTORY
# ============================================================================
RESULTS_DIR=/workspace/agent-green/results

# ============================================================================
# DEEPSEEK CONTEXT LENGTH
# ============================================================================
# DeepSeek-R1-Distill-Llama models inherit 128K context from Llama 3.1/3.3
# Standardized to 64K to match Qwen3 experiments for fair comparison
#
# vLLM --max-model-len options:
#   8B FP16:  65536 (64K) - standardized for cross-model comparison
#   70B INT8: 32768       - reduced for memory constraints
