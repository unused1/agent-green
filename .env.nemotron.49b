# RunPod Configuration for Llama-Nemotron-Super-49B Cross-Architecture Validation
# Date: 2025-12-07
# Reference: docs/Cross_Architecture_Validation_Plan.md

# ============================================================================
# PROJECT CONFIGURATION
# ============================================================================
PROJECT_ROOT=/workspace/agent-green

# ============================================================================
# BACKEND SELECTION
# ============================================================================
USE_RUNPOD=true  # vLLM uses OpenAI-compatible API

# ============================================================================
# MODEL FAMILY IDENTIFIER
# ============================================================================
MODEL_FAMILY=nemotron

# ============================================================================
# REASONING MODE TOGGLE
# ============================================================================
# Nemotron-Super-49B v1.5 uses different toggle:
# - Default (empty system prompt) = Thinking ON
# - "/no_think" in system prompt = Thinking OFF
ENABLE_REASONING=false  # Will be toggled by experiment script

# ============================================================================
# MODEL CONFIGURATION (RunPod - H100 GPU)
# ============================================================================

# --- Llama-3.3-Nemotron-Super-49B-v1.5 ---
# Base: Llama-3.3 | Architecture: Dense | Context: 128K | Precision: FP8
# Toggle: System prompt (default=ON, "/no_think"=OFF)
# Note: Requires FP8 quantization for single H100 80GB
REASONING_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
REASONING_ENDPOINT=http://localhost:8000/v1
REASONING_API_KEY=

BASELINE_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
BASELINE_ENDPOINT=http://localhost:8000/v1
BASELINE_API_KEY=

# ============================================================================
# DATASETS
# ============================================================================
VULN_DATASET=/workspace/agent-green/vuln_database/VulTrial_386_samples_balanced.jsonl
HUMANEVAL_DATASET=/workspace/agent-green/vuln_database/HumanEval.jsonl

# ============================================================================
# EXPERIMENT SETTINGS
# ============================================================================
# Nemotron recommended settings:
# - Thinking ON: temperature=0.6, top_p=0.95
# - Thinking OFF: temperature=0.0 (greedy)
# For cross-architecture comparison, we use temperature=0.0 to match Qwen3 baseline
TEMPERATURE=0.0
LLM_SERVICE=openai

# ============================================================================
# RESULTS DIRECTORY
# ============================================================================
RESULTS_DIR=/workspace/agent-green/results

# ============================================================================
# NEMOTRON-49B CONTEXT LENGTH
# ============================================================================
# 49B with FP8: ~49GB weights + KV cache for 64K context
# Estimated total: ~60-70GB on H100 80GB (should fit)
# If OOM occurs, reduce to 32768
MAX_CONTEXT_LENGTH=65536

# ============================================================================
# QUANTIZATION NOTE
# ============================================================================
# vLLM deployment for 49B requires FP8 quantization:
#   --quantization fp8
#   --gpu-memory-utilization 0.95
