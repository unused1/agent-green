           GF_LOG(GF_LOG_ERROR, GF_LOG_CONTAINER, (""[AV1] could not parse AV1 OBU at position ""LLU"". Leaving parsing.\n"", pos));
           break;
       }
       assert(obu_size == gf_bs_get_position(bs) - pos);
       // ... more processing
   }
   ```
   This loop reads OBU data from the bitstream. It checks the size of each OBU against the remaining data.

8. There's a check to ensure the OBU size doesn't exceed the remaining data:
   ```c
   if (size<obu_size) {
       GF_LOG(GF_LOG_WARNING, GF_LOG_CONTAINER, (""[AV1] AV1 config misses %d bytes to fit the entire OBU\n"", obu_size - size));
       break;
   }
   size -= (u32) obu_size;
   ```
   This is a good check to prevent reading beyond the available data.

